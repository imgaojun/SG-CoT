  "throughput_presets": {
    "stageA_default": {
      "finetuning_type": "lora",
      "lora_rank": 8,
      "lora_target": "all",
      "cutoff_len": 1024,
      "max_samples": 1000,
      "per_device_train_batch_size": 2,
