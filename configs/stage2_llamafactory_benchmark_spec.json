      "lora_rank": 8,
      "lora_target": "all",
      "cutoff_len": 1536,
      "max_samples": 1000,
      "per_device_train_batch_size": 2,
      "gradient_accumulation_steps": 8,
      "packing": true,
      "max_steps": 50,
      "learning_rate": 5.0e-05,
      "warmup_ratio": 0.03,
      "bf16": true
    },
    "throughput_long_ctx": {
      "finetuning_type": "lora",
      "lora_rank": 8,
      "lora_target": "all",
      "cutoff_len": 2048,
      "max_samples": 1000,
      "per_device_train_batch_size": 1,
